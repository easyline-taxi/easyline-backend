# nginx.default
upstream django_server {
    server 0.0.0.0:8001;
}
server {
    listen 8000;
    server_name localhost;

    location / {
        proxy_pass http://django_server;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    location /static {
        root /app/;
    }
}