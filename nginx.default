# nginx.default
upstream django_server {
    server 0.0.0.0:8001;
}

upstream django_server_asgi {
    server 0.0.0.0:8002;
}
server {
    listen 8000;
    server_name easyline.ml;

    location /static {
        root /app/;
    }
    
    location ~ /ws {
        proxy_pass http://django_server_asgi;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://django_server;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
    
    
}